# Shemsu SMS Application Configuration
# Copy this file to .env and fill in your actual values

# SMS Provider (options: 'twilio', 'nexmo', 'mock')
SMS_PROVIDER=mock

# Twilio Configuration (uncomment if using Twilio)
# TWILIO_ACCOUNT_SID=your_account_sid_here
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_PHONE_NUMBER=+1234567890

# Nexmo/Vonage Configuration (uncomment if using Nexmo)
# NEXMO_API_KEY=your_api_key_here
# NEXMO_API_SECRET=your_api_secret_here
# NEXMO_PHONE_NUMBER=+1234567890

# Application Settings
DEBUG=True
LOG_LEVEL=INFO
